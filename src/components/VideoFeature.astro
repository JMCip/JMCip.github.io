---
/**
 * Cuadro para anclar un video reproducible en la página de Inicio.
 *
 * Para usar tu video:
 * 1. Coloca el archivo (ej. "demo.mp4") en /public/videos/demo.mp4
 * 2. Cambia el valor de `videoSrc` abajo por "/videos/demo.mp4"
 *    (o pega un link externo si prefieres, ej. de YouTube embebido).
 * 3. Opcional: agrega una imagen de portada en /public y ponla en `posterSrc`.
 */
const videoSrc = ''; // <-- pon aquí la ruta o URL de tu video
const posterSrc = ''; // <-- opcional: ruta de una imagen de portada
---

<section id="video" class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8" aria-labelledby="video-heading">
  <h2 id="video-heading" class="section-heading">Video</h2>
  <div class="reveal-content mt-8">
    <div class="panel-card overflow-hidden p-0">
      {
        videoSrc ? (
          <video
            controls
            preload="metadata"
            poster={posterSrc || undefined}
            class="aspect-video w-full bg-black"
          >
            <source src={videoSrc} />
            Tu navegador no soporta la reproducción de video.
          </video>
        ) : (
          <div class="flex aspect-video w-full flex-col items-center justify-center gap-2 bg-black/30 text-center text-sm text-slate">
            <p class="font-semibold text-white-soft">Aún no hay video cargado</p>
            <p class="max-w-xs text-xs opacity-70">
              Agrega tu archivo de video y define <code>videoSrc</code> en
              <code> VideoFeature.astro</code> para que se reproduzca aquí.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>