---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import FolderCard from '../../components/FolderCard.astro';
import { models } from '../../../data/models';
import { modelFolders } from '../../../data/model-folders';
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

const title = `Modelado | ${site.hero.name}`;
const description = `Modelos entidad-relación de ${site.hero.name}.`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const homeHref = base;
---

<ArchiveLayout title={title} description={description}>
  <p class="mb-8">
    <a href={homeHref} class="group flex items-center gap-2 text-sm text-accent transition hover:text-slate-light" data-astro-prefetch>
      <Icon name="ph:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      {site.hero.name}
    </a>
  </p>

  <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-4xl">Modelado</h1>

  <p class="mb-10 max-w-prose body-copy">
    Trabajos de la clase de Bases de Datos, organizados por tipo. Dale clic a una carpeta para ver sus modelos.
  </p>

  <div class="grid gap-8 sm:grid-cols-3">
    {modelFolders.map((folder) => (
      <FolderCard folder={folder} count={models.filter((m) => m.category === folder.slug).length} />
    ))}
  </div>
</ArchiveLayout>