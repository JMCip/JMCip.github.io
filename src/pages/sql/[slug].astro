---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import SqlExerciseCard from '../../components/SqlExerciseCard.astro';
import { sqlFolders } from '../../../data/sql';
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return sqlFolders.map((folder) => ({
    params: { slug: folder.slug },
    props: { folder },
  }));
}

const { folder } = Astro.props;
const title = `${folder.title} | ${site.hero.name}`;
const description = `${folder.title}: ${folder.description}`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<ArchiveLayout title={title} description={description}>
  <p class="mb-8">
    <a href={`${base}sql`} class="group flex items-center gap-2 text-sm text-accent transition hover:text-slate-light" data-astro-prefetch>
      <Icon name="ph:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      SQL
    </a>
  </p>

  <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-4xl">{folder.title}</h1>

  <p class="mb-10 max-w-prose body-copy">{folder.description}</p>

  {
    folder.exercises.length > 0 ? (
      <div class="flex flex-col gap-8">
        {folder.exercises.map((exercise, i) => <SqlExerciseCard exercise={exercise} index={i} />)}
      </div>
    ) : (
      <div class="panel-card flex flex-col items-center gap-2 py-16 text-center">
        <p class="font-semibold text-slate">Aún no hay ejercicios en esta carpeta</p>
        <p class="max-w-sm text-sm text-slate-light">
          Agrega ejercicios a esta carpeta en <code>data/sql.ts</code> para que aparezcan aquí.
        </p>
      </div>
    )
  }
</ArchiveLayout>
