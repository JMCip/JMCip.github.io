---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import NormalizationStepper from '../../components/NormalizationStepper.astro';
import { normalizationExercises } from '../../../data/normalization';
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return normalizationExercises.map((exercise) => ({
    params: { id: exercise.id },
    props: { exercise },
  }));
}

const { exercise } = Astro.props;
const title = `${exercise.title} | ${site.hero.name}`;
const description = exercise.description ?? `Normalización: ${exercise.title}.`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<ArchiveLayout title={title} description={description}>
  <p class="mb-8">
    <a href={`${base}normalizacion`} class="group flex items-center gap-2 text-sm text-accent transition hover:text-slate-light" data-astro-prefetch>
      <Icon name="ph:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      Normalización
    </a>
  </p>

  <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-4xl">{exercise.title}</h1>

  {exercise.description && <p class="mb-10 max-w-prose body-copy">{exercise.description}</p>}

  <NormalizationStepper steps={exercise.steps} />
</ArchiveLayout>